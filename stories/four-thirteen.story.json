          "acting": {
            "gesture": "question",
            "expression": "upset",
            "gaze": "right",
            "intensity": "medium"
          }
        },
        {
          "type": "line",
          "speaker": "千早爱音",
          "text": "然而什么啊？soyorin 你快别卖关子了！",
          "subtext": "她真的想知道，但更怕听到“没有为什么”。",
          "durationSec": 5.0
