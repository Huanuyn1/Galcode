        {
          "type": "figure",
          "character": "长崎爽世",
          "assetId": "figure-chara-soyo-casual-spring-01-adv-live2d-soyo-004-casual-spring-01-model3-json-70338f3706b1d1bf",
          "position": "right",
          "acting": {
            "gesture": "idle",
            "expression": "smile",
            "gaze": "left",
            "intensity": "low"
          },
          "expression": "exp_smile01"
