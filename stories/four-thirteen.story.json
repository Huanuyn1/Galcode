          "acting": {
            "gesture": "surprised",
            "expression": "surprised",
            "gaze": "right",
            "intensity": "medium"
          }
        },
        {
          "type": "line",
          "speaker": "千早爱音",
          "text": "诶？？然后呢！",
          "subtext": "她只是在捧哏，等一个能继续讲下去的转折。",
          "durationSec": 3.5
