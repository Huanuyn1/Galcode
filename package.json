{
  "name": "galcode",
  "version": "1.0.0",
  "description": "AI 驱动的 MyGO/Ave Mujica WebGAL 二创工作室:dsh TUI 创作台 + 编译预览 + Chromium 确定性录制出片。",
  "keywords": ["webgal", "mygo", "ave-mujica", "live2d", "galgame", "dsh", "ai", "tui", "video-recorder"],
  "repository": { "type": "git", "url": "https://github.com/Huanuyn1/Galcode.git" },
  "homepage": "https://github.com/Huanuyn1/Galcode",
  "bugs": "https://github.com/Huanuyn1/Galcode/issues",
  "type": "module",
  "bin": {
    "galcode": "./bin/galcode.js",
    "galcode-mcp": "./bin/galcode-mcp.js"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "packages/dsh-galcode/",
    "themes/",
    "docs/",
    "figure/README.md",
    "galcode",
    "galcode.bat",
    "start.sh",
    "start.bat",
    "install.sh",
    "install.bat",
    "ROADMAP.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "galcode": "node ./bin/galcode.js",
    "mcp": "node ./bin/galcode-mcp.js",
    "check": "node ./bin/galcode.js --help",
    "demo": "node ./bin/galcode.js cli yolo --offline --out outputs/demo",
    "install:all": "node ./scripts/galcode-bootstrap.mjs install",
    "start:cli": "node ./scripts/galcode-bootstrap.mjs start",
    "doctor": "node ./bin/galcode.js doctor",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.3",
    "pnpm": "12.9.1",
    "puppeteer-core": "^25.12.0"
  },
  "license": "MIT",
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "vitest": "^5.0.3"
  }
}
